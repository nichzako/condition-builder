generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Formula {
  id        String   @id @default(cuid())
  name      String   @default("Untitled")
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([name])
}
